# Database (shared with sales-insight-service)
DATABASE_URL=postgresql://sales_user:sales_password@localhost:5432/sales_db

# Redis
REDIS_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Application
APP_NAME=Apriori Market Basket Analysis API v2
APP_VERSION=2.0.0
LOG_LEVEL=INFO
DEBUG=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Performance
CACHE_TTL_SECONDS=900
SYNC_THRESHOLD=50000
MATVIEW_REFRESH_MINUTES=30
BATCH_SIZE=10000
