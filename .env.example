# Database (same as sales-insight-service)
DATABASE_URL=postgresql://sales_user:sales_password@localhost:5432/sales_db

# Redis
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Application
APP_NAME=Apriori Association Rules API
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DEBUG=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# LLM (optional - set LLM_ENABLED=true to activate)
LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6-20250514
